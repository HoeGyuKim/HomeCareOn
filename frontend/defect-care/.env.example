# ─────────────────────────────────────────────
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# 비워두면 테스트 모드(메모리 저장소 + 규칙 기반 분석)로 동작합니다.
# ─────────────────────────────────────────────

# Claude API — 설정 시 통화 분석에 Claude 사용
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Supabase — 두 값 모두 설정 시 Supabase DB 사용 (supabase/schema.sql 먼저 실행)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
